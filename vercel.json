
{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api|.*\\.).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebook|[Ff]acebot|[Mm]eta|[Ww]hats[Aa]pp|[Gg]oogle|[Bb]ing|[Tt]witter|[Ll]inkedin|[Ss]lack|[Tt]elegram|[Aa]pplebot|[Bb]ot|[Ss]pider|[Cc]rawler|[Ss]craper).*"
        }
      ],
      "destination": "/api/ssr?path=$1"
    },
    {
      "source": "/((?!api|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
