
{
  "functions": {
    "api/ssr.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api|.*\\..*).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebook|facebot|facebookexternalhit|facebookcatalog|meta-externalagent|whatsapp|twitter|twitterbot|linkedin|linkedinbot|slack|slackbot|telegram|telegrambot|applebot|google|googlebot|bing|bingbot|yandex|duckduckbot|baiduspider|rogerbot|embedly|quora|showyoubot|outbrain|pinterest|vkshare|w3c_validator|screaming frog|semrush|ahrefs|bot|crawler|spider|scraper).*"
        }
      ],
      "destination": "/api/ssr?path=$1"
    },
    {
      "source": "/((?!api|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
